datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id              String           @id @default(cuid())
  email           String           @unique
  name            String
  role            String           @default("CUSTOMER") // CUSTOMER, CREATOR, SUPPLIER, ADMIN
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  creatorProfile  CreatorProfile?
  supplierProfile SupplierProfile?
  designs         DesignDocument[]
  orders          Order[]
  auditEvents     AuditEvent[]
}

model CreatorProfile {
  id                 String                    @id @default(cuid())
  userId             String                    @unique
  user               User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug               String                    @unique
  displayName        String
  bio                String?
  avatarUrl          String?
  website            String?
  payoutDetails      String?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  artworks           Artwork[]
  storefrontSettings CreatorStorefrontSettings?
  financialAccount   FinancialAccount?
}

model SupplierProfile {
  id               String            @id @default(cuid())
  userId           String            @unique
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug             String            @unique
  companyName      String
  description      String?
  location         String
  contactEmail     String
  contactPhone     String?
  leadTimeDays     Int               @default(5)
  minOrderQuantity Int               @default(1)
  verified         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  products         GarmentProduct[]
  printingServices PrintingService[]
  orders           Order[]
}

model Artwork {
  id               String              @id @default(cuid())
  creatorId        String
  creator          CreatorProfile      @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  title            String
  description      String?
  category         String              @default("ILLUSTRATION") // MASCOT, TYPOGRAPHY, ILLUSTRATION, PATTERN, LOGO
  previewUrl       String
  originalUrl      String?
  mimeType         String              @default("image/png")
  tags             String?
  status           String              @default("PUBLISHED") // DRAFT, PUBLISHED, ARCHIVED
  moderationStatus String              @default("APPROVED") // PENDING, APPROVED, REJECTED
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  licenseOptions   LicenseOption[]
  obligations      RoyaltyObligation[]
  fileSpec         ArtworkFileSpec?
}

model LicenseOption {
  id             String              @id @default(cuid())
  artworkId      String
  artwork        Artwork             @relation(fields: [artworkId], references: [id], onDelete: Cascade)
  name           String
  price          Int // in THB
  commercialUse  Boolean             @default(true)
  terms          String?
  scope          String              @default("PER_GARMENT") // PER_GARMENT, UNLIMITED
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  obligations    RoyaltyObligation[]
}

model GarmentProduct {
  id             String           @id @default(cuid())
  supplierId     String
  supplier       SupplierProfile  @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  sku            String           @unique
  name           String
  description    String?
  fabric         String           @default("100% Combed Cotton")
  weightGsm      Int              @default(240)
  fit            String           @default("oversized") // regular, oversized, boxy
  neckline       String           @default("crew") // crew, v-neck, polo
  basePrice      Int              @default(150) // in THB
  packagingPrice Int              @default(15) // in THB
  shippingPrice  Int              @default(40) // in THB
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  variants       GarmentVariant[]
  designs        DesignDocument[]
}

model GarmentVariant {
  id              String         @id @default(cuid())
  productId       String
  product         GarmentProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku             String         @unique
  colorName       String
  colorHex        String
  size            String // S, M, L, XL, XXL
  stock           Int            @default(100)
  priceAdjustment Int            @default(0) // in THB
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model PrintingService {
  id                String          @id @default(cuid())
  supplierId        String
  supplier          SupplierProfile @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  name              String
  code              String          @default("DTG")
  description       String?
  pricePerSurface   Int             @default(80) // in THB
  maxPrintWidthCm   Float           @default(35.0)
  maxPrintHeightCm  Float           @default(45.0)
  supportedSurfaces String          @default("BOTH") // FRONT, BACK, BOTH
  minOrderQty       Int             @default(1)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model DesignDocument {
  id               String          @id @default(cuid())
  userId           String?
  user             User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  title            String          @default("Custom Tee")
  garmentProductId String
  garmentProduct   GarmentProduct  @relation(fields: [garmentProductId], references: [id])
  garmentVariantId String?
  garmentColorHex  String          @default("#131718")
  garmentSize      String          @default("L")
  garmentFit       String          @default("oversized")
  frontElements    String          @default("[]") // JSON string of DesignElement[]
  backElements     String          @default("[]") // JSON string of DesignElement[]
  sideElements     String          @default("[]") // JSON string of DesignElement[]
  previewFrontUrl  String?
  previewBackUrl   String?
  status           String          @default("READY_FOR_QUOTE") // DRAFT, SAVED, READY_FOR_QUOTE, ORDERED
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  orders           Order[]
}

model Order {
  id              String              @id @default(cuid())
  orderNumber     String              @unique
  customerId      String?
  customer        User?               @relation(fields: [customerId], references: [id], onDelete: SetNull)
  designId        String
  design          DesignDocument      @relation(fields: [designId], references: [id])
  supplierId      String
  supplier        SupplierProfile     @relation(fields: [supplierId], references: [id])
  quantity        Int                 @default(1)
  status          String              @default("PAYMENT_CONFIRMED") // DRAFT, QUOTED, AWAITING_PAYMENT, PAYMENT_CONFIRMED, IN_PRODUCTION, SHIPPED, DELIVERED, CANCELLED
  paymentMode     String              @default("DEV_MOCK")
  paymentStatus   String              @default("PAID")
  totalAmount     Int // in THB
  garmentCost     Int // in THB
  printingCost    Int // in THB
  licensingCost   Int // in THB
  packagingCost   Int // in THB
  shippingCost    Int // in THB
  shippingName    String
  shippingAddress String
  shippingCity    String
  shippingPostal  String
  shippingPhone   String?
  snapshotData    String? // JSON snapshot of complete design & pricing at checkout
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  obligations     RoyaltyObligation[]
  journalEntries  JournalEntry[]
}

model RoyaltyObligation {
  id              String                @id @default(cuid())
  orderId         String
  order           Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  creatorId       String
  artworkId       String
  artwork         Artwork               @relation(fields: [artworkId], references: [id])
  licenseOptionId String
  licenseOption   LicenseOption         @relation(fields: [licenseOptionId], references: [id])
  unitRoyalty     Int // in THB
  quantity        Int                   @default(1)
  totalAmount     Int // in THB
  status          String                @default("PENDING") // PENDING, ELIGIBLE, SETTLED, CANCELLED
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  ledgerEntries   RoyaltyLedgerEntry[]
}

model RoyaltyLedgerEntry {
  id           String             @id @default(cuid())
  creatorId    String
  obligationId String?
  obligation   RoyaltyObligation? @relation(fields: [obligationId], references: [id], onDelete: SetNull)
  entryType    String // EARNING, PAYOUT_SETTLEMENT, ADJUSTMENT
  amount       Int // in THB (positive or negative)
  balanceAfter Int // in THB
  reference    String?
  notes        String?
  createdAt    DateTime           @default(now())
}

model CreatorSettlement {
  id               String   @id @default(cuid())
  creatorId        String
  settlementNumber String   @unique
  totalAmount      Int // in THB
  status           String   @default("COMPLETED") // PENDING, COMPLETED, CANCELLED
  payoutReference  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model AuditEvent {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  actorId    String?  // Optional actor identifier (user ID, 'SYSTEM', 'RECONCILIATION_ENGINE')
  action     String
  entityType String
  entityId   String?
  payload    String?  // JSON string
  metadata   String?  // JSON string for additional context/telemetry
  createdAt  DateTime @default(now())
}

model CreatorStorefrontSettings {
  id                 String         @id @default(cuid())
  creatorId          String         @unique
  creator            CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  customSlug         String?        @unique
  bio                String?
  bannerUrl          String?
  avatarUrl          String?
  socialLinks        String?        // JSON string: { instagram, twitter, behance, tiktok, youtube, website }
  themePreferences   String?        // JSON string: { primaryColor, accentColor, font, mode }
  featuredArtworkIds String?        // JSON string array of artwork IDs: ["art_1", "art_2"]
  badgeVerified      Boolean        @default(false)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
}

model ArtworkFileSpec {
  id                     String   @id @default(cuid())
  artworkId              String   @unique
  artwork                Artwork  @relation(fields: [artworkId], references: [id], onDelete: Cascade)
  storagePath            String   // Local filesystem path e.g. public/uploads/masters/[id].png
  storageKey             String?  // Storage key / relative reference e.g. masters/[id].png
  mimeType               String   // image/png, image/svg+xml, image/tiff, image/jpeg
  width                  Int      // Width in pixels
  height                 Int      // Height in pixels
  dpi                    Int      @default(300) // Minimum 300 DPI (or 0 for vector)
  colorSpace             String   @default("sRGB") // sRGB, Display P3, CMYK
  hasTransparency        Boolean  @default(false)
  isVector               Boolean  @default(false)
  previewWatermarkedPath String?  // Watermarked public preview path
  fileSize               Int      // File size in bytes
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model CommissionRule {
  id            String    @id @default(cuid())
  name          String    @unique // e.g. "STANDARD_15_85", "EXCLUSIVE_CREATOR_TIER"
  platformRate  Float     @default(0.15) // 15% platform commission rate
  creatorRate   Float     @default(0.85) // 85% creator royalty share rate
  isActive      Boolean   @default(true)
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?
  description   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model FinancialAccount {
  id            String          @id @default(cuid())
  accountType   String          // CREATOR, PLATFORM, ESCROW
  accountNumber String          @unique // e.g. "ACC-CREATOR-dash-ape", "ACC-PLATFORM-REVENUE", "ACC-ESCROW-HOLDING"
  balance       Int             @default(0) // In THB
  currency      String          @default("THB")
  creatorId     String?         @unique
  creator       CreatorProfile? @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  status        String          @default("ACTIVE") // ACTIVE, FROZEN, CLOSED
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  journalEntries JournalEntry[]
}

model JournalEntry {
  id           String           @id @default(cuid())
  accountId    String
  account      FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  entryType    String           // DEBIT, CREDIT
  amount       Int              // In THB (positive integer)
  balanceAfter Int              // Balance of this account after this transaction
  orderId      String?
  order        Order?           @relation(fields: [orderId], references: [id], onDelete: SetNull)
  reference    String?          // e.g. orderNumber, settlementNumber
  description  String?
  createdAt    DateTime         @default(now())
}

model ReconciliationReport {
  id                          String    @id @default(cuid())
  period                      String    // e.g. "2026-10", "2026-W41"
  periodStart                 DateTime?
  periodEnd                   DateTime?
  totalGmv                    Int       @default(0) // Gross Merchandise Value in THB
  totalCommission             Int       @default(0) // Total 15% platform commission
  totalCreatorRoyalties       Int       @default(0) // Total 85% creator royalties
  matchedItemsCount           Int       @default(0)
  discrepancyCount            Int       @default(0)
  status                      String    @default("BALANCED") // BALANCED, DISCREPANCY, PENDING, RECONCILED
  balanceConservationVerified Boolean   @default(true) // Verified sum(Credits) == sum(Debits)
  discrepancyDetails          String?   // JSON diagnostics if discrepancy detected
  generatedBy                 String?   // User ID or "SYSTEM"
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt
}
